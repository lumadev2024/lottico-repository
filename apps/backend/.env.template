STORE_CORS=http://localhost:8000,https://docs.medusajs.com
ADMIN_CORS=http://localhost:5173,http://localhost:9000,https://docs.medusajs.com
AUTH_CORS=http://localhost:5173,http://localhost:9000,https://docs.medusajs.com
REDIS_URL=redis://localhost:6379
JWT_SECRET=supersecret
COOKIE_SECRET=supersecret
DATABASE_URL=
DB_NAME=medusa-backend

# Bank transfer payment provider ("Bonifico bancario"). Not secrets — these
# are shown to customers on the order confirmation page — but still never
# commit real values here or to any tracked file. BIC and BANK_NAME are
# optional; ACCOUNT_HOLDER and IBAN are required to offer this method in
# production (see src/modules/bank-transfer/service.ts validateOptions).
BANK_TRANSFER_ACCOUNT_HOLDER=
BANK_TRANSFER_IBAN=
BANK_TRANSFER_BIC=
BANK_TRANSFER_BANK_NAME=

# Supabase Storage (S3-compatible) for product media. Server-side only —
# never exposed to the storefront. Leave empty in development to keep using
# the local filesystem provider; required in production (the backend throws
# at startup otherwise, since Railway's filesystem doesn't persist uploads).
# Get endpoint/region/keys from the Supabase dashboard: Storage > Configuration > S3.
SUPABASE_S3_ENDPOINT=
SUPABASE_S3_REGION=
SUPABASE_S3_ACCESS_KEY_ID=
SUPABASE_S3_SECRET_ACCESS_KEY=
SUPABASE_STORAGE_BUCKET=
SUPABASE_STORAGE_PUBLIC_URL=
